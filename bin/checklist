#!/usr/bin/env bash
# Delivery checklist — local single-command merge gate.
#
# Role (Flutter ./bin/checklist parity): agents/humans run this before opening a
# PR. GitHub Actions parallelizes the same lanes in .github/workflows/ci.yml;
# merge only when the hosted `checklist` job is green.
#
# Lanes (same scripts CI uses):
#   markdown → DesignMD → Swift lint/modularity → common checks → scheme list
#   → iPhone tests (bin/ci-iphone-test.sh) → iPad/Mac builds (bin/ci-platform-builds.sh)
#
# Xcode warnings are errors by default (tool/xcode_warnings_as_errors_flags.sh).
# Escape: XCODEBUILD_ALLOW_WARNINGS=1 or CHECKLIST_SKIP_PLATFORM_BUILDS=1
#
# Usage: ./bin/checklist [--help]
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"

show_help() {
  cat <<'EOF'
Usage: ./bin/checklist [--help]

Full local delivery checklist (merge gate):
  - Markdown lint
  - DESIGN.md DesignMD lint
  - Swift lint + modularity + engineering scorecard (./bin/lint.sh)
  - Common issue checks
  - Xcode project/scheme listing
  - iPhone unit/UI tests (./bin/ci-iphone-test.sh) — warnings as errors
  - iPad + Mac builds (./bin/ci-platform-builds.sh) — unless skipped

Env:
  CHECKLIST_SKIP_PLATFORM_BUILDS=1  Skip iPad/Mac builds
  XCODEBUILD_ALLOW_WARNINGS=1       Do not treat Xcode warnings as errors

Narrow docs/tooling: ./bin/checklist-fast
Hosted PR gate:      GHA job `checklist` (parallel lint + iphone-test + platform-builds)
Docs:                docs/engineering/checklist_gate.md
EOF
}

case "${1:-}" in
  -h|--help|help)
    show_help
    exit 0
    ;;
  "")
    ;;
  *)
    echo "error: unknown option: $1" >&2
    show_help >&2
    exit 2
    ;;
esac

echo "==> Markdown lint"
./bin/lint-markdown.sh

echo "==> DESIGN.md lint (DesignMD)"
./tool/check_design_md.sh

echo "==> Swift lint"
./bin/lint.sh

echo "==> Common issue checks"
./tool/check_common_issues.sh

echo "==> Project/scheme sanity"
xcodebuild -list -project superDemoApp.xcodeproj

echo "==> iPhone tests (./bin/ci-iphone-test.sh; warnings as errors)"
./bin/ci-iphone-test.sh

if [[ "${CHECKLIST_SKIP_PLATFORM_BUILDS:-0}" != "1" ]]; then
  echo "==> iPad + Mac builds (./bin/ci-platform-builds.sh; warnings as errors)"
  ./bin/ci-platform-builds.sh
else
  echo "info: skipping iPad/Mac builds because CHECKLIST_SKIP_PLATFORM_BUILDS=1"
fi

echo "Checklist passed."
echo "Next: open PR; merge only when GHA job checklist is green."
echo "See: docs/engineering/checklist_gate.md"
