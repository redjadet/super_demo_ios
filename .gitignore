# SwiftPM
.build/
.swiftpm/
Package.resolved

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Local env / secrets
.env
.env.*
*.pem

# Cursor IDE (local workspace; never commit)
.cursor/
**/.cursor/

# VS Code / Cursor editor settings (local; never commit)
.vscode/
**/.vscode/
*.code-workspace

# Agent isolated worktrees (./bin/agent-worktree)
.worktrees/

# Agent task trackers (local per machine)
tasks/
**/tasks/

# Agent / Superpowers scratch (regeneratable session ledgers, briefs, diffs)
.superpowers/
**/.superpowers/

# Executable plans — local only (never commit; regenerate or keep on disk)
docs/plans/*
!docs/plans/README.md
docs/superpowers/plans/*
!docs/superpowers/plans/README.md

# Bundler / Fastlane
.bundle/
vendor/bundle/
fastlane/Matchfile
fastlane/README.md
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Regeneratable Xcode / test artifacts
*.xcresult
TestResults/
*.xcactivitylog

# Project skills (restored from skills-lock.json via npx skills experimental_install)
.agents/
.context/
