# frozen_string_literal: true

require "shellwords"

# Orchestrates existing bin/ and tool/ scripts for local dev and GitHub Actions.
# Keeps simulator/Xcode pinning in bash; Fastlane provides one entry point and CI caching.

default_platform(:ios)

PROJECT = "superDemoApp.xcodeproj"
SCHEME = "superDemoApp"
APP_IDENTIFIER = "com.ilkersevim.superDemoApp"
TESTFLIGHT_RELEASE_NOTES_REL_PATH = "docs/release-notes/testflight.md"
APP_STORE_RELEASE_NOTES_REL_PATH = "docs/release-notes/app-store.md"
TESTFLIGHT_OUTPUT_REL_DIR = "build/testflight"

def repo_root
  @repo_root ||= File.expand_path("..", __dir__)
end

def ci?
  ENV["CI"] == "true"
end

def required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Set #{name} before running the TestFlight beta lane.") if value.empty?
  value
end

def repo_path(path)
  File.expand_path(path, repo_root)
end

def release_notes_from(path)
  UI.user_error!("Release notes file missing: #{path}") unless File.file?(path)

  notes = File.read(path).strip
  UI.user_error!("Release notes file is empty: #{path}") if notes.empty?
  UI.user_error!("Release notes still contain TODO: #{path}") if notes.match?(/\bTODO\b/i)

  notes
end

def testflight_release_notes
  release_notes_from(
    repo_path(ENV.fetch("TESTFLIGHT_RELEASE_NOTES_PATH", TESTFLIGHT_RELEASE_NOTES_REL_PATH))
  )
end

def app_store_release_notes
  release_notes_from(
    repo_path(ENV.fetch("APP_STORE_RELEASE_NOTES_PATH", APP_STORE_RELEASE_NOTES_REL_PATH))
  )
end

def release_build_number
  required_env("TESTFLIGHT_BUILD_NUMBER")
end

def match_enabled?
  ENV["FASTLANE_USE_MATCH"] == "1" || File.file?(repo_path("fastlane/Matchfile"))
end

def sync_app_store_signing
  return unless match_enabled?

  UI.message("Syncing App Store signing via match (copy fastlane/Matchfile.example to Matchfile to configure).")
  match(
    type: "appstore",
    readonly: ci? || ENV.fetch("MATCH_READONLY", "1") == "1",
    app_identifier: APP_IDENTIFIER
  )
end

def app_store_connect_auth_options
  options = {}
  api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
  options[:api_key_path] = repo_path(api_key_path) unless api_key_path.empty?
  options
end

def prepare_release_build
  select_xcode
  sync_app_store_signing

  if ENV["TESTFLIGHT_SKIP_CI"] == "1"
    UI.important("Skipping CI proof (TESTFLIGHT_SKIP_CI=1). Use only after a same-commit proof run.")
  else
    ci
  end
end

def build_store_ipa(build_number:, reviewer_demo: false)
  xcargs = ["CURRENT_PROJECT_VERSION=#{build_number.shellescape}"]
  if reviewer_demo
    xcargs << "SWIFT_ACTIVE_COMPILATION_CONDITIONS=#{"$(inherited) REVIEWER_DEMO".shellescape}"
  end

  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    clean: true,
    export_method: "app-store",
    destination: "generic/platform=iOS",
    output_directory: repo_path(TESTFLIGHT_OUTPUT_REL_DIR),
    output_name: "superDemoApp-#{build_number}.ipa",
    xcargs: xcargs.join(" ")
  )
end

def run_repo_script(rel_path, extra_env: {})
  previous_env = {}
  extra_env.each do |key, value|
    key = key.to_s
    previous_env[key] = ENV.key?(key) ? ENV[key] : nil
    ENV[key] = value
  end
  script = File.join(repo_root, rel_path)
  begin
    Dir.chdir(repo_root) do
      sh(script)
    end
  ensure
    extra_env.each_key do |key|
      key = key.to_s
      if previous_env[key].nil?
        ENV.delete(key)
      else
        ENV[key] = previous_env[key]
      end
    end
  end
end

platform :ios do
  desc "Select newest released Xcode (>= 26.5); beta only if no release qualifies"
  lane :select_xcode do
    run_repo_script("tool/select_xcode.sh")
  end

  desc "Swift lint (indent, agent patterns, SwiftLint, SwiftFormat, layers)"
  lane :lint do
    run_repo_script("bin/lint.sh")
  end

  desc "Markdown lint"
  lane :lint_markdown do
    run_repo_script("bin/lint-markdown.sh")
  end

  desc "DESIGN.md DesignMD lint (requires Node npx)"
  lane :lint_design_md do
    run_repo_script("tool/check_design_md.sh")
  end

  desc "Agent guardrails and repo sanity checks"
  lane :common_checks do
    run_repo_script("tool/check_common_issues.sh")
  end

  desc "Safe Swift format (SwiftFormat)"
  lane :format do
    run_repo_script("bin/format.sh")
  end

  desc "Lint job lane for GitHub Actions (checklist lint slice + DesignMD)"
  lane :ci_lint do
    select_xcode if ci?
    lint
    lint_markdown
    lint_design_md
    common_checks
  end

  desc "Boot iPhone simulator on CI when CI_SIMULATOR_DEST is unset"
  lane :prepare_iphone_simulator do
    run_repo_script(
      "tool/ensure_ci_simulator.sh",
      extra_env: { "CI_PREPARE_IPAD" => "0" }
    )
  end

  desc "Boot iPad simulator on CI when CI_IPAD_DEST is unset"
  lane :prepare_ipad_simulator do
    run_repo_script(
      "tool/ensure_ci_simulator.sh",
      extra_env: { "CI_PREPARE_IPHONE" => "0" }
    )
  end

  desc "iPhone build + unit/UI tests (same as bin/ci-iphone-test.sh)"
  lane :iphone_test do
    run_repo_script(
      "bin/ci-iphone-test.sh",
      extra_env: { "CI_PREPARE_IPAD" => ENV.fetch("CI_PREPARE_IPAD", "0") }
    )
  end

  desc "iPad simulator + macOS compile proof (bin/ci-platform-builds.sh)"
  lane :platform_builds do
    run_repo_script(
      "bin/ci-platform-builds.sh",
      extra_env: { "CI_PREPARE_IPHONE" => ENV.fetch("CI_PREPARE_IPHONE", "0") }
    )
  end

  desc "Full local/CI proof: lint, DesignMD, common checks, platform builds, iPhone tests"
  lane :ci do
    ENV["CI"] = "true" unless ENV.key?("CI")
    # Xcode pin happens inside ci-iphone-test / ci-platform-builds when CI=true.
    lint
    lint_markdown
    lint_design_md
    common_checks

    if ENV["CI_SKIP_PLATFORM_BUILDS"] == "1"
      UI.important("Skipping iPad/Mac (CI_SKIP_PLATFORM_BUILDS=1)")
      iphone_test
    elsif ci?
      platform_builds
      iphone_test
    else
      iphone_test
      platform_builds
    end

    UI.success("CI lanes passed.")
  end

  desc "Fast checklist: markdown, swift lint, common checks, design md, xcode list"
  lane :checklist_fast do
    lint_markdown
    lint
    common_checks
    lint_design_md
    Dir.chdir(repo_root) do
      sh("xcodebuild", "-list", "-project", PROJECT)
    end
  end

  desc "Full checklist: lint, design md, iPhone test, iPad/Mac (bin/checklist)"
  lane :checklist do
    run_repo_script("bin/checklist")
  end

  desc "Sync App Store certificates/profiles via match when Matchfile or FASTLANE_USE_MATCH=1"
  lane :sync_signing do
    select_xcode
    UI.user_error!("Set FASTLANE_USE_MATCH=1 or add fastlane/Matchfile (see Matchfile.example).") unless match_enabled?
    sync_app_store_signing
  end

  desc "CI proof, signed App Store archive only (no upload)"
  lane :build_ipa do
    build_number = release_build_number
    prepare_release_build
    ipa_path = build_store_ipa(build_number: build_number)
    UI.success("Release IPA: #{ipa_path}")
  end

  desc "Production beta: CI proof, signed archive, TestFlight upload"
  lane :beta do
    build_number = release_build_number
    notes = testflight_release_notes
    prepare_release_build
    ipa_path = build_store_ipa(build_number: build_number, reviewer_demo: true)

    if ENV["TESTFLIGHT_SKIP_UPLOAD"] == "1"
      UI.important("Built TestFlight archive without upload: #{ipa_path}")
      next
    end

    upload_to_testflight(
      ipa: ipa_path,
      changelog: notes,
      skip_waiting_for_build_processing: true,
      **app_store_connect_auth_options
    )
  end

  desc "App Store upload from release IPA (metadata from docs/release-notes/app-store.md)"
  lane :release do
    build_number = release_build_number
    notes = app_store_release_notes
    prepare_release_build
    ipa_path = build_store_ipa(build_number: build_number)

    if ENV["APP_STORE_SKIP_UPLOAD"] == "1"
      UI.important("Built App Store archive without upload: #{ipa_path}")
      next
    end

    upload_to_app_store(
      ipa: ipa_path,
      skip_screenshots: true,
      skip_metadata: ENV["APP_STORE_SKIP_METADATA"] == "1",
      release_notes: { "en-US" => notes },
      submit_for_review: ENV["APP_STORE_SUBMIT_FOR_REVIEW"] == "1",
      skip_waiting_for_build_processing: true,
      **app_store_connect_auth_options
    )
  end
end
